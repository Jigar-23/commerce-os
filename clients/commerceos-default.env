# ==============================================================================
# Commerce OS Authoritative Production Environment
# Client ID: commerceos-default (Commerce OS Platform)
# Generated by whitelabel-cli on 2026-10-27T20:17:27.726Z
# ==============================================================================

NODE_ENV=production
PORT=8080

# Authoritative Isolated Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/commerce_os

# Routing & Telemetry Service
OSRM_BASE_URL=https://router.project-osrm.org

# Cryptographic Token Invariants
JWT_SECRET=production_jwt_secret_hs256_at_least_32_chars_long
JWT_ISSUER=commerceos-auth
JWT_AUDIENCE=commerceos-clients
COMMERCEOS_OTP_PEPPER=production_otp_pepper_salt_64chars_long_entropy

# Firebase Cloud Messaging (Data-Only Invariant)
FCM_SERVER_KEY=fcm_key_production_token
FCM_ENDPOINT_URL=https://fcm.googleapis.com/fcm/send

# Direct 0%-Fee NPCI UPI Payments
MERCHANT_UPI_VPA=commerceos@okaxis
MERCHANT_UPI_NAME="Commerce OS Store"

# Fulfillment & Store Configuration
DEFAULT_STORE_ID=store_main_01
MULTI_STORE_ENABLED=true
MAX_SERVICE_RADIUS_KM=10
TARGET_DELIVERY_SLA_MINUTES=10

# Customer Support
SUPPORT_PHONE=+1-800-COMMERCE
SUPPORT_EMAIL=support@commerceos.io

# Cloudflare R2 Object Storage (Inject via Secret Manager in Production)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=commerce-os-1
R2_PUBLIC_DOMAIN=https://your-r2-subdomain.r2.dev

