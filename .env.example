# ==============================================================================
# COMMERCE OS PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node & Framework Environment
NODE_ENV=development
PORT=8083
WEB_PORT=3000

# Backend Public API Origin (Unified Edge Gateway / BFF)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8083

# Master Fulfillment Hub Authority
STORE_MASTER_ID=STORE_MASTER_001
STORE_MASTER_NAME=Commerce OS Central Fulfillment Hub
STORE_MASTER_ADDRESS=Central Dark Store Hub, Sector 18
STORE_MASTER_LAT=28.2021899
STORE_MASTER_LNG=76.6153954
STORE_MASTER_CONTACT_PHONE=+9118002008000

# PostgreSQL Database Connections
DATABASE_URL=postgresql://user:password@localhost:5432/commerceos_db
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/commerceos_db
SPRING_DATASOURCE_USERNAME=commerceos
SPRING_DATASOURCE_PASSWORD=commerceos_dev_password

# Kafka Event Bus Broker
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Distributed Cache & Locks
REDIS_URL=redis://:commerceos_redis_secret@localhost:6379

# JWT Security Secrets (Must be supplied via secret manager in production)
JWT_SECRET=your_production_jwt_secret_key_minimum_32_chars
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=commerce-os-auth
JWT_AUDIENCE=commerce-os-api

# Payment Gateway Webhook Secrets (Stripe / Razorpay)
PAYMENT_GATEWAY_WEBHOOK_SECRET=your_payment_webhook_secret_here

# SMS-OTP Gateway (Mobile Phone Authentication)
TWO_FACTOR_API_KEY=your_sms_gateway_api_key_here
